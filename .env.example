# Copy to .env.local and fill in. Never commit real values.
# Every integration is optional: if its variables are empty the feature is
# simply switched off (see README → "Configuration").
# src/server/config/env.js validates all of this on build and start (task 06):
#   - with DATABASE_URL set, AUTH_SECRET and IP_HASH_SALT are required;
#   - on Vercel production (VERCEL_ENV=production, set by Vercel) the 3-INFRA §6 list is required.
# VERCEL_ENV=

# ── Site ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (Neon PostgreSQL) ──────────────────────────
# Set → pages read from the database; empty → static /content.
# Pooled connection for the app (add ?sslmode=require&pgbouncer=true — the
# pooler does not support Prisma's prepared statements otherwise), direct
# connection for migrations.
DATABASE_URL=
DIRECT_URL=
# Seed: set to true to push /content copy over existing rows (default keeps admin edits).
# SEED_OVERWRITE=true

# ── Enquiries ───────────────────────────────────────────
# Salt for hashing visitor IPs (any long random string).
IP_HASH_SALT=
# Resend API key + where enquiry notifications go (comma separated).
RESEND_API_KEY=
ENQUIRY_FROM_EMAIL="Insta Mark Website <website@your-domain.in>"
ENQUIRY_NOTIFY_EMAILS=
# The visitor's auto-reply (R-7.8) is sent only when ENQUIRY_FROM_EMAIL is on a
# Resend-verified domain. Tests only — never set it anywhere else:
# RESEND_BASE_URL=

# ── Spam protection (Cloudflare Turnstile) ──────────────
# Test keys that always pass: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analytics (Google Analytics 4) ──────────────────────
NEXT_PUBLIC_GA_ID=

# ── Daily maintenance cron (Vercel sends it as Bearer token) ──
CRON_SECRET=

# ── Images (Cloudinary) — used by `npm run images:migrate` ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Logs and error tracking (D6, task 08) ───────────────
# pino JSON logs: fatal | error | warn | info (default) | debug | trace | silent
LOG_LEVEL=
# Sentry: errors are sent only when both DSNs are set (same DSN for both).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional, Vercel build only: upload source maps so Sentry shows real line numbers.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Admin panel (/admin) ────────────────────────────────
# Signs the admin JWT (task 05). Required with a database. Use 32+ random chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# First admin user: `npm run admin:create` reads these (password never from argv).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
