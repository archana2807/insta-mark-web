{
  "name": "insta-mark-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Insta Mark — architectural signage & road safety solutions website",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node --test",
    "test:e2e": "node tests/e2e/run.js",
    "test:e2e:fast": "node tests/e2e/run.js --no-build",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "check:content": "node scripts/check-content.js",
    "build:vercel": "node scripts/migrate-if-configured.js && next build",
    "images:migrate": "node scripts/migrate-images-to-cloudinary.js",
    "admin:create": "node scripts/create-admin.js",
    "icons": "node scripts/build-icons.js",
    "check:env": "node scripts/check-env.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@prisma/client": "6.19.3",
    "bootstrap": "5.3.3",
    "next": "15.5.27",
    "react": "19.1.9",
    "react-bootstrap": "2.10.10",
    "react-dom": "19.1.9",
    "resend": "4.0.1",
    "yet-another-react-lightbox": "3.21.7",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-socket": "0.2.13",
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.64.1",
    "bootstrap-icons": "1.11.3",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "prettier": "3.3.3",
    "prisma": "6.19.3",
    "sass": "1.80.6"
  },
  "overrides": {
    "sharp": "0.35.5",
    "postcss": "8.5.30",
    "deepmerge-ts": "8.0.2"
  }
}
